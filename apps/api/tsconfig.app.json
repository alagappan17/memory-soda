{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node"],
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  // Tests import sibling modules by their real `.ts` path (node runs them
  // directly, stripping types) and are never part of the shipped build.
  "exclude": ["src/**/*.test.ts"],
  "references": [
    {
      "path": "../../packages/types/tsconfig.lib.json"
    }
  ]
}
