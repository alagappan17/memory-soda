# Copy this file to .env.prod and fill in all values before running production Docker.
# .env.prod is gitignored and should never be committed.

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3004
MIGRATE_ON_START=true

# ── CORS ───────────────────────────────────────────────────────────────────────
# URL where the dashboard is served (used by the API to allow browser requests)
CORS_ORIGIN=https://your-dashboard.example.com
# Same value, used by docker-compose.prod.yml as WEB_URL
WEB_URL=https://your-dashboard.example.com

# ── Database (PostgreSQL + pgvector) ───────────────────────────────────────────
POSTGRES_USER=memory_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=memory_db
# DATABASE_URL is assembled automatically by docker-compose.prod.yml.
# Set manually only if connecting to an external database.
# DATABASE_URL=postgresql://memory_user:changeme@postgres:5432/memory_db

# ── Cache (Redis) ──────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Graph Database (Neo4j) ─────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme

# ── AI (required — get your key at aistudio.google.com) ───────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Dashboard ──────────────────────────────────────────────────────────────────
# Public URL of the API server as seen from the browser (not from inside Docker).
NEXT_PUBLIC_API_URL=https://your-api.example.com
API_URL=https://your-api.example.com
