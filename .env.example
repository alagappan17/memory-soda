# Server
HOST=localhost
PORT=3004
CORS_ORIGIN=http://localhost:3000

# Run DB migrations automatically on startup (required on first boot)
MIGRATE_ON_START=true

# PostgreSQL — matches docker-compose.yml defaults
POSTGRES_USER=memory_user
POSTGRES_PASSWORD=memory_pass
POSTGRES_DB=memory_db
DATABASE_URL=postgresql://memory_user:memory_pass@localhost:5432/memory_db

# Redis
REDIS_URL=redis://localhost:6379

# Neo4j — matches docker-compose.yml defaults
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=memory_pass

# Google Gemini (required — get yours at aistudio.google.com)
GOOGLE_GENERATIVE_AI_API_KEY=

# Web
NEXT_PUBLIC_API_URL=http://localhost:3004