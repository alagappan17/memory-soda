# Server
HOST=localhost
PORT=3004
CORS_ORIGIN=http://localhost:3000

# Run DB migrations automatically on startup (required on first boot)
MIGRATE_ON_START=true

# PostgreSQL (requires the pgvector extension — `CREATE EXTENSION vector;`)
# Point this at your local Postgres instance.
DATABASE_URL=postgresql://memory_user:memory_pass@localhost:5432/memory_db

# Google Gemini (required — get yours at aistudio.google.com)
GOOGLE_GENERATIVE_AI_API_KEY=

# Model and endpoint overrides. All optional; the defaults are shown.
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_MS=30000
# GEMINI_STRUCTURED_TIMEOUT_MS=90000
# GEMINI_EMBED_MODEL=models/gemini-embedding-001
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
#
# Embedding size is pinned to the vector(768) columns in the schema. Changing it
# needs a migration and a re-embed of every stored vector, not just this value.
# GEMINI_EMBED_DIM=768

# Web
NEXT_PUBLIC_API_URL=http://localhost:3004