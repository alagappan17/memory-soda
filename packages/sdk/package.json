{
  "name": "@alagappan17/memory-soda",
  "version": "0.2.0",
  "description": "Memory for AI agents. Threads in, recalled context out.",
  "keywords": [
    "ai",
    "memory",
    "agent",
    "llm",
    "sdk",
    "ai-sdk",
    "vercel-ai",
    "rag"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@memory-soda/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./ai": {
      "@memory-soda/source": "./src/ai/index.ts",
      "types": "./dist/ai/index.d.ts",
      "import": "./dist/ai/index.js",
      "require": "./dist/ai/index.cjs",
      "default": "./dist/ai/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/dist"
        ],
        "cache": true,
        "options": {
          "cwd": "packages/sdk",
          "command": "tsup"
        },
        "dependsOn": [
          "^build"
        ]
      },
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node --test \"packages/sdk/src/**/*.test.ts\""
        }
      }
    }
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  },
  "scripts": {
    "prepublishOnly": "tsup"
  }
}
