{
  "name": "@memory-soda/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "update": "git pull && npm install",
    "dev": "concurrently -n api,web -c cyan,magenta \"nx serve @memory-soda/api\" \"nx dev @memory-soda/dashboard\"",
    "build": "nx run-many --target=build --all",
    "lint": "eslint .",
    "test": "nx run-many --target=test --all",
    "typecheck": "nx run-many --target=typecheck --all",
    "sdk:build": "nx build @memory-soda/sdk",
    "sdk:publish": "npm run sdk:build && npm publish --workspace=packages/sdk --access public",
    "installer:publish": "npm publish --workspace=packages/create-memory-soda --access public",
    "docs:dev": "nx dev @memory-soda/docs",
    "docs:build": "nx build @memory-soda/docs",
    "docs:check-links": "nx check-links @memory-soda/docs",
    "release": "nx release",
    "lint:fix": "eslint . --fix",
    "db:migrate": "npm run --workspace=apps/api db:migrate",
    "db:generate": "npm run --workspace=apps/api db:generate",
    "prepare": "husky"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nx/devkit": "22.6.4",
    "@nx/esbuild": "22.6.4",
    "@nx/js": "22.6.4",
    "@nx/node": "^22.6.4",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/node": "20.19.9",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "nx": "22.6.4",
    "prettier": "~3.6.2",
    "tslib": "^2.3.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.67.0",
    "yaml": "^2.9.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,mdx,css}": [
      "prettier --write"
    ]
  }
}
