# syntax=docker/dockerfile:1
FROM node:22-alpine AS builder

WORKDIR /workspace

COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY packages/types/package.json ./packages/types/

RUN npm install

COPY tsconfig.base.json tsconfig.json nx.json ./
COPY apps/api ./apps/api
COPY packages/types ./packages/types

RUN npx nx sync --verbose
RUN npx nx run @memory-soda/api:prune

# ---- runtime ----
FROM node:22-alpine AS runner

WORKDIR /app

COPY --from=builder /workspace/apps/api/dist .
COPY --from=builder /workspace/apps/api/dist/workspace_modules ./workspace_modules

RUN npm install --only=production --ignore-scripts

ENV NODE_ENV=production
EXPOSE 3004

CMD ["node", "main.js"]
